# ==============================================================================
# OTTER ASSISTANT — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME=Otter Assistant
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-key
# Generate Fernet key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-valid-fernet-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (MySQL 8.0+ — Source of Truth) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=otter_assistant
MYSQL_USER=otter_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+pymysql://otter_user:change-me@mysql:3306/otter_assistant

# --- Redis (Cache, Rate Limiting, Distributed Locks ONLY) ---
REDIS_URL=redis://redis:6379/0

# --- Google Gemini API (Free Tier) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# --- UTH Integrations ---
PORTAL_BASE_URL=https://portal.ut.edu.vn
PORTAL_SCHEDULE_ENDPOINT=/api/v1/lichhoc/lichTuan
# Leave blank until an official Portal refresh endpoint is verified
PORTAL_REFRESH_ENDPOINT=
PORTAL_TOKEN_REFRESH_BUFFER_SECONDS=300
PORTAL_USE_MOCK=false
# Configure current UTH semester dates (YYYY-MM-DD). PORTAL_SEMESTER_END_DATE is required for semester sync.
PORTAL_SEMESTER_START_DATE=
PORTAL_SEMESTER_END_DATE=
PORTAL_SEMESTER_MAX_WEEKS=24
PORTAL_WEEK_REQUEST_DELAY_SECONDS=0.3
PORTAL_AUTO_SYNC_INTERVAL_HOURS=6
LMS_BASE_URL=https://courses.ut.edu.vn
LMS_USE_MOCK=false

# --- Telegram Bot API (@BotFather) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=OtterAssistantBot
# Random secret passed to Telegram setWebhook(secret_token=...) to verify X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001/api/v1
